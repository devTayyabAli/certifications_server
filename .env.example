# Server Environment Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection
MONGODB_URI=mongodb://127.0.0.1:27017/siherdefi

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_siherdefi_2026_change_in_production
JWT_EXPIRES_IN=7d

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Blockchain / Web3 Config
BASE_CHAIN_ID=8453
RPC_URL=https://mainnet.base.org

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_WINDOW_MS=600000
AUTH_RATE_LIMIT_MAX=10

# SMTP Configuration (Nodemailer Email Reminders)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM="Si Her DeFi" <no-reply@siherdefi.org>

# Frontend Dapp URL (used for email calendar links & redirects)
FRONTEND_URL=http://localhost:3000/siherdefi


# Development only: shift a session for testing (slug@ISO-start+minutes)
DEV_SESSION_OVERRIDES=

# --- Security ---
# Proxies in front of the API (Render / Nginx / Cloudflare): 1 for one hop.
# Required in production so rate limits see each learner's real IP.
TRUST_PROXY=0
# JWT: tokens are bound to this issuer/audience. In production JWT_SECRET must
# be a unique random value of 32+ characters (e.g. `openssl rand -hex 32`).
JWT_ISSUER=siherdefi-api
JWT_AUDIENCE=siherdefi-app
# Signs learners' private calendar-subscription links (`openssl rand -hex 32`).
# Optional — JWT_SECRET is used when empty — but set it, so rotating JWT_SECRET
# doesn't break the calendars people already subscribed to.
CALENDAR_FEED_SECRET=
# Max request body (profile photos are resized in the browser below this)
BODY_LIMIT=3mb
# Sign-in codes per email address per hour, and changes per learner per minute
OTP_EMAIL_MAX_PER_HOUR=5
WRITE_RATE_LIMIT_PER_MINUTE=120

# On-chain badges (LearningBadges contract). Learners claim with a server-signed voucher; claiming stays off until the contract and the signer key are both set.
CERTIFICATE_CONTRACT_ADDRESS=0x7cd507273609f887bdb797d0c35583132274586b
# base | base-sepolia | sepolia (Ethereum Sepolia)
CERTIFICATE_CHAIN=sepolia
# Optional RPC for that chain (a public one is used when empty)
CERTIFICATE_RPC_URL=
# SECRET: private key of the account with CLAIM_SIGNER_ROLE. It only signs claim vouchers: no funds needed. Set it only in Vercel / your local .env, never commit it.
CLAIM_SIGNER_PRIVATE_KEY=
